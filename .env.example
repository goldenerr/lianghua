# Development/test only. Copy to .env.local and set a real local value.
# Never commit .env.local or production secret material.
AUDIT_ARCHIVE_HMAC_KEY=

# Optional dev/test service tokens. Production must use an approved secret manager
# or platform identity, not committed values.
SECRET_MANAGER_SERVICE_TOKEN=
APPROVAL_SERVICE_TOKEN=
EXCHANGE_POSITION_SERVICE_TOKEN=

# Non-secret production service endpoints/refs used by the V29 paper launch
# package. Tokens and API keys must stay in Vault/AWS SM/sealed secrets.
QUANT_PRODUCTION_EVIDENCE_FILE=config/production_evidence.v29.local.json
QUANT_SECRET_MANAGER_URL=
QUANT_SECRET_MANAGER_TOKEN_REF=
QUANT_APPROVAL_SERVICE_URL=
QUANT_POSITION_PROVIDER_URL=
QUANT_MARKET_DATA_PROVIDER_REF=

